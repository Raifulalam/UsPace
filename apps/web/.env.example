# Public URL of the API (must match CLIENT_ORIGIN settings on the API side).
# Dev: web on localhost:3000 and API on localhost:4000 are same-SITE, so the SameSite=Strict refresh cookie works.
# Production: serve web and API under the same registrable domain (app.example.com + api.example.com).
NEXT_PUBLIC_API_URL=http://localhost:4000
# Production on Vercel: set NEXT_PUBLIC_API_URL=https://uspace-ubq2.onrender.com and NEXT_PUBLIC_API_PROXY=1
# (REST goes through this site so the SameSite=Strict cookie works; sockets still connect to the API directly).
# NEXT_PUBLIC_API_PROXY=1
