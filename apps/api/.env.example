NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/couples
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
CLIENT_ORIGIN=http://localhost:3000
# Production example:
# CLIENT_ORIGIN=https://wespc.vercel.app
# Optional comma-separated origins for Android/emulator or LAN web clients.
# Example: http://10.0.2.2:3000
ADDITIONAL_CLIENT_ORIGINS=http://127.0.0.1:3000
MIN_AGE=18
INVITATION_TTL_HOURS=72
BCRYPT_COST=12
REQUIRE_EMAIL_VERIFICATION=false

# ---- Firebase Cloud Messaging (optional) ----
# Never commit service-account JSON or private keys. Use your secret manager in production.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-...@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Admin dashboard (leave commented to keep the admin API switched off) ----
# ADMIN_JWT_SECRET=replace-with-a-different-random-secret-of-32+-characters
# ADMIN_MFA_KEY=replace-with-another-random-secret-of-32+-characters
# ADMIN_ORIGIN=http://localhost:3001

# ---- Calls ----
# Public STUN lets phones discover their address (the default is Google's; self-host coturn for more privacy).
# STUN_URLS=stun:stun.l.google.com:19302
# A TURN relay is needed on strict networks (some mobile carriers, offices). It only ever sees encrypted media.
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_SECRET=the-same-value-as-static-auth-secret-in-turnserver.conf-16+-chars
# TURN_TTL_SECONDS=3600
